package spotify_report

Nord :: struct {
	r, g, b: u8,
}

// Polar Night
NORD0  :: Nord{0x2E, 0x34, 0x40}
NORD1  :: Nord{0x3B, 0x42, 0x52}
NORD2  :: Nord{0x43, 0x4C, 0x5E}
NORD3  :: Nord{0x4C, 0x56, 0x6A}

// Snow Storm
NORD4  :: Nord{0xD8, 0xDE, 0xE9}
NORD5  :: Nord{0xE5, 0xE9, 0xF0}
NORD6  :: Nord{0xEC, 0xEF, 0xF4}

// Frost
NORD7  :: Nord{0x8F, 0xBC, 0xBB}
NORD8  :: Nord{0x88, 0xC0, 0xD0}
NORD9  :: Nord{0x81, 0xA1, 0xC1}
NORD10 :: Nord{0x5E, 0x81, 0xAC}

// Aurora
NORD11 :: Nord{0xBF, 0x61, 0x6A}
NORD12 :: Nord{0xD0, 0x87, 0x70}
NORD13 :: Nord{0xEB, 0xCB, 0x8B}
NORD14 :: Nord{0xA3, 0xBE, 0x8C}
NORD15 :: Nord{0xB4, 0x8E, 0xAD}
